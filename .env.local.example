# Copy this file to .env.local and fill in your key.
# Get a FREE key (no credit card) at: https://console.groq.com/keys
# NEVER commit .env.local to version control.

GROQ_API_KEY=your_key_here

# Optional: override the default models
# GROQ_MODEL=llama-3.3-70b-versatile   # journal analysis (default)
# GROQ_CHAT_MODEL=llama-3.1-8b-instant  # chat companion (default)
